# Supabase — error logging only (anon key is safe for client insert-only RLS)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AI companion (required for live responses)
EXPO_PUBLIC_AI_API_KEY=your-openai-or-groq-key

