# Supabase — error logging + anonymous cloud sync (anon key is safe with RLS)
# Enable Anonymous sign-in: Dashboard → Authentication → Providers → Anonymous
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional public landing URL for shared verses (falls back to biblia-ai:// deep link)
# EXPO_PUBLIC_SHARE_URL=https://biblia-ai.app

# Optional store links appended to invite / streak / practice shares
# EXPO_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/id0000000000
# EXPO_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.solidcodeapps.bibliaai

# Verse comments on VOTD card (enabled by default when Supabase env is set; migration 003_votd_social.sql)

# Google Play in-app donation product IDs (consumables — one-time gifts)
# Create matching products in Play Console → Monetize → Products → In-app products
# EXPO_PUBLIC_IAP_DONATE_10=biblia_donate_10
# EXPO_PUBLIC_IAP_DONATE_30=biblia_donate_30
# EXPO_PUBLIC_IAP_DONATE_50=biblia_donate_50

# AdMob app IDs (required by react-native-google-mobile-ads plugin)
# EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
# EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy

# AdMob ad units (platform-specific, production)
# EXPO_PUBLIC_ADMOB_BANNER_HOME_ANDROID_ID=ca-app-pub-xxxxxxxxxxxxxxxx/zzzzzzzzzz
# EXPO_PUBLIC_ADMOB_BANNER_HOME_IOS_ID=ca-app-pub-xxxxxxxxxxxxxxxx/zzzzzzzzzz
# EXPO_PUBLIC_ADMOB_INTERSTITIAL_CORE_ANDROID_ID=ca-app-pub-xxxxxxxxxxxxxxxx/zzzzzzzzzz
# EXPO_PUBLIC_ADMOB_INTERSTITIAL_CORE_IOS_ID=ca-app-pub-xxxxxxxxxxxxxxxx/zzzzzzzzzz

# Backward-compatible shared unit IDs (optional)
# EXPO_PUBLIC_ADMOB_BANNER_HOME_ID=ca-app-pub-xxxxxxxxxxxxxxxx/zzzzzzzzzz
# EXPO_PUBLIC_ADMOB_INTERSTITIAL_CORE_ID=ca-app-pub-xxxxxxxxxxxxxxxx/zzzzzzzzzz

# AI companion (required for live responses)
EXPO_PUBLIC_AI_API_KEY=your-openai-or-groq-key
# Optional automatic failover: used when the primary key is rate-limited/overloaded.
# Add as many as you like (EXPO_PUBLIC_AI_API_KEY_2, _3); each may be comma-separated.
# EXPO_PUBLIC_AI_API_KEY_2=your-second-key
EXPO_PUBLIC_AI_PROVIDER=groq

# Optional AI overrides
# Groq defaults in app:
# EXPO_PUBLIC_AI_API_URL=https://api.groq.com/openai/v1/chat/completions
# EXPO_PUBLIC_AI_MODEL=llama-3.3-70b-versatile
#
# OpenAI defaults in app:
# EXPO_PUBLIC_AI_API_URL=https://api.openai.com/v1/chat/completions
# EXPO_PUBLIC_AI_MODEL=gpt-4o-mini
