# Supabase — error logging + anonymous cloud sync (anon key is safe with RLS)
# Enable Anonymous sign-in: Dashboard → Authentication → Providers → Anonymous
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AI companion (required for live responses)
EXPO_PUBLIC_AI_API_KEY=your-openai-or-groq-key
EXPO_PUBLIC_AI_PROVIDER=groq

# Optional AI overrides
# Groq defaults in app:
# EXPO_PUBLIC_AI_API_URL=https://api.groq.com/openai/v1/chat/completions
# EXPO_PUBLIC_AI_MODEL=llama-3.3-70b-versatile
#
# OpenAI defaults in app:
# EXPO_PUBLIC_AI_API_URL=https://api.openai.com/v1/chat/completions
# EXPO_PUBLIC_AI_MODEL=gpt-4o-mini
